<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Thông báo một lần do thao tác trước để lại. Include nó làm phần tử con đầu tiên của <main>, để nó thuộc nội dung trang
     (skip link nhảy tới trước nó) và lỗi được đọc to và nhận focus (assets/form-messages.js).
     flashError true: lỗi; flashInfo true: thông báo trung tính; còn lại: thành công. --%>
<c:if test="${not empty flashMessage}">
    <c:choose>
        <c:when test="${flashError}"><div class="notice error" role="alert" tabindex="-1" data-focus-error-summary><strong class="notice-label">Có lỗi.</strong> <c:out value="${flashMessage}"/></div></c:when>
        <c:when test="${flashInfo}"><div class="notice info" role="status" tabindex="-1"><c:out value="${flashMessage}"/></div></c:when>
        <c:otherwise><div class="notice success" role="status" tabindex="-1"><strong class="notice-label">Thành công.</strong> <c:out value="${flashMessage}"/></div></c:otherwise>
    </c:choose>
</c:if>
