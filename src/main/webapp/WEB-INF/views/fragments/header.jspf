<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%-- Số trên badge = tổng số lượng (số món) trong giỏ, không phải số dòng của giỏ. --%>
<c:set var="cartItemCount" value="0"/>
<c:forEach items="${sessionScope.shoppingCart.items}" var="cartLine"><c:set var="cartItemCount" value="${cartItemCount + cartLine.quantity}"/></c:forEach>
<c:set var="requestPath" value="${requestScope['jakarta.servlet.forward.servlet_path']}"/>
<c:choose>
    <c:when test="${empty requestPath}"><c:set var="requestPath" value="${pageContext.request.servletPath}${pageContext.request.pathInfo}"/></c:when>
    <c:otherwise><c:set var="requestPath" value="${requestPath}${requestScope['jakarta.servlet.forward.path_info']}"/></c:otherwise>
</c:choose>
<%-- Giao diện admin theo vai trò đang đăng nhập, không theo URL: khách hàng mở /admin vẫn thấy header cửa hàng trên trang 403. --%>
<c:set var="adminPage" value="${fn:startsWith(requestPath, '/admin') and sessionScope.user.role == 'ADMIN'}"/>
<c:set var="onStore" value="${requestPath eq '/products' or requestPath eq '/search' or requestPath eq '/product'}"/>
<c:set var="onCart" value="${requestPath eq '/cart' or requestPath eq '/cart/'}"/>
<c:set var="onOrders" value="${requestPath eq '/orders' or requestPath eq '/orders/detail'}"/>
<a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
<header class="topbar<c:if test='${adminPage}'> topbar-admin</c:if>">
    <a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark" aria-hidden="true"><%@ include file="/WEB-INF/views/fragments/logo-mark.jspf" %></span><span class="brand-name">Lime <em>&amp;</em> Lemon</span></a>
    <c:if test="${not adminPage}">
        <div class="mobile-header-actions">
            <details class="mobile-search">
                <summary class="mobile-icon-button" aria-label="Mở tìm kiếm sản phẩm">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                </summary>
                <form class="mobile-search-form" method="get" action="${pageContext.request.contextPath}/search" role="search">
                    <label class="visually-hidden" for="mobile-search-keyword">Tìm sản phẩm</label>
                    <input id="mobile-search-keyword" type="search" name="keyword" maxlength="100" placeholder="Tìm sản phẩm">
                    <button type="submit" aria-label="Tìm kiếm"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg></button>
                </form>
            </details>
            <a class="mobile-cart-link" href="${pageContext.request.contextPath}/cart" aria-label="Giỏ hàng (${cartItemCount})">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 4h2l2.2 11.1a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 1.9-1.4L22 8H6"></path><circle cx="10" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg>
                <span class="visually-hidden">Giỏ hàng</span>
                <c:if test="${cartItemCount gt 0}"><span class="cart-count" aria-label="${cartItemCount} sản phẩm trong giỏ"><c:out value="${cartItemCount}"/></span></c:if>
            </a>
        </div>
    </c:if>
    <details class="site-menu" open>
        <summary class="menu-toggle"><span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span><span class="visually-hidden">Mở menu</span></summary>
        <nav class="site-nav" aria-label="Điều hướng chính">
            <c:if test="${not adminPage}">
                <form class="site-search" method="get" action="${pageContext.request.contextPath}/search" role="search">
                    <label class="visually-hidden" for="site-search-keyword">Tìm sản phẩm</label>
                    <input id="site-search-keyword" type="search" name="keyword" maxlength="100" placeholder="Tìm sản phẩm">
                    <button type="submit" aria-label="Tìm kiếm"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg></button>
                </form>
                <a class="nav-link" href="${pageContext.request.contextPath}/"<c:if test="${homePage}"> aria-current="page"</c:if>>Trang chủ</a>
                <a class="nav-link" href="${pageContext.request.contextPath}/products"<c:if test="${onStore}"> aria-current="page"</c:if>>Sản phẩm</a>
                <a class="nav-link" href="${pageContext.request.contextPath}/cart"<c:if test="${onCart}"> aria-current="page"</c:if>>Giỏ hàng<c:if test="${cartItemCount gt 0}"><span class="cart-count"><c:out value="${cartItemCount}"/><span class="visually-hidden"> sản phẩm trong giỏ</span></span></c:if></a>
            </c:if>
            <c:choose>
                <c:when test="${sessionScope.user.role == 'ADMIN'}">
                    <a class="nav-link" href="${pageContext.request.contextPath}/admin"<c:if test="${adminPage}"> aria-current="page"</c:if>>Quản trị</a>
                    <c:if test="${adminPage}"><a class="nav-link" href="${pageContext.request.contextPath}/">Cửa hàng</a></c:if>
                </c:when>
                <c:when test="${not empty sessionScope.user}">
                    <a class="nav-link" href="${pageContext.request.contextPath}/orders"<c:if test="${onOrders}"> aria-current="page"</c:if>>Đơn hàng</a>
                </c:when>
                <c:otherwise>
                    <a class="nav-link" href="${pageContext.request.contextPath}/account/login"<c:if test="${requestPath eq '/account/login'}"> aria-current="page"</c:if>>Đăng nhập</a>
                    <a class="button button-small" href="${pageContext.request.contextPath}/account/register"<c:if test="${requestPath eq '/account/register'}"> aria-current="page"</c:if>>Đăng ký</a>
                </c:otherwise>
            </c:choose>
            <c:if test="${not empty sessionScope.user}">
                <form class="inline" method="post" action="${pageContext.request.contextPath}/account/logout">
                    <button class="link-button" type="submit">Đăng xuất</button>
                </form>
            </c:if>
        </nav>
    </details>
</header>
<script src="${pageContext.request.contextPath}/assets/site-menu.js?v=${assetVersion}" defer></script>
<script src="${pageContext.request.contextPath}/assets/form-messages.js?v=${assetVersion}" defer></script>
<script src="${pageContext.request.contextPath}/assets/reveal.js?v=${assetVersion}" defer></script>
